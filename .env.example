# انسخ هذا الملف إلى .env وعدّل القيم قبل التشغيل أو النشر.
PORT=3000

# المزود الافتراضي مجاني ولا يحتاج مفتاحاً.
# pollinations = صور مجانية (بدون مفتاح، بحد زمني)
# mock = تجريب محلي بدون شبكة
# xai = مدفوع (يحتاج XAI_API_KEY) ويفتح خيار الفيديو
PROVIDER=pollinations

# كلمة سر لوحة الإدارة. غيّرها قبل النشر ولا تشاركها.
# لا تضع كلمة السر الحقيقية في هذا الملف ولا في الشات.
ADMIN_PASSWORD=change-me-before-deploy

# اختياري: مفتاح Pollinations السري. يبقى على الخادم ولا يُرسل للمتصفح.
# إذا تُرك فارغاً يُستخدم المسار المجاني بدون مفتاح (image.pollinations.ai).
# لا تضع المفتاح الحقيقي هنا.
POLLINATIONS_API_KEY=

# اختياري: النموذج المجاني فقط. الافتراضي flux. لا تضع نموذجاً مدفوعاً.
# POLLINATIONS_MODEL=flux

# اختياري: فقط إذا اخترت PROVIDER=xai
XAI_API_KEY=

# اختياري
# SESSION_SECRET=put-a-long-random-string-here
# XAI_IMAGE_MODEL=grok-imagine-image-2.0
# XAI_VIDEO_MODEL=grok-imagine-video-1.5
# XAI_VIDEO_POLL_MS=4000
# XAI_VIDEO_TIMEOUT_MS=300000
